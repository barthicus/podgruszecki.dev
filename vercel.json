{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bpodgruszecki.vercel.app"
        }
      ],
      "destination": "https://podgruszecki.dev/:path*",
      "permanent": true
    },
    {
      "source": "/all-projects/:view(grid|list)",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/cv-pdf",
      "destination": "/cv/bartosz-podgruszecki-cv.pdf",
      "permanent": true
    }
  ]
}
