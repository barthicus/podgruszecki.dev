---
import '@/styles/global.css'

import { getImage } from 'astro:assets'

import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'

import photo from '@/assets/photo/bartosz.jpg'
import { getProfile } from '@/data/profile'
import { alternatePath, cleanPath, type Lang } from '@/i18n'

type Props = {
  lang: Lang
  title: string
  description: string
  ogImage?: string
  noindex?: boolean
  bodyClass?: string
  ogType?: 'profile' | 'website'
  /** Page-level schema.org nodes, added to the shared Person + WebSite graph */
  jsonLd?: Record<string, unknown>[]
}

const { lang, title, description, ogImage = '/og.png', noindex = false, bodyClass, ogType = 'website', jsonLd = [] } = Astro.props
const profile = getProfile(lang)
const alternates = (['en', 'pl'] as const).map(l => ({ lang: l, href: new URL(alternatePath(Astro.url.pathname, l), Astro.site) }))
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site)
const ogImageUrl = new URL(ogImage, Astro.site)

const photoUrl = new URL((await getImage({ src: photo, width: 400, format: 'jpg' })).src, Astro.site)

// Shared entities, referenced by @id from page-level structured data
const person = {
  '@type': 'Person',
  '@id': `${profile.site}/#person`,
  name: profile.name,
  jobTitle: profile.role,
  description: profile.pitch,
  url: profile.site,
  image: photoUrl.href,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressCountry: 'PL' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Wroclaw University of Economics' },
  knowsLanguage: ['pl', 'en'],
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: ['React', 'TypeScript', 'TanStack Start', 'Next.js', 'Node.js', 'Three.js', '3D product configurators', 'Telehealth software', 'Route planning software', 'AI-assisted development']
}
const website = {
  '@type': 'WebSite',
  '@id': `${profile.site}/#website`,
  url: profile.site,
  name: profile.name,
  inLanguage: ['en', 'pl'],
  publisher: { '@id': person['@id'] }
}
const jsonLdGraph = { '@context': 'https://schema.org', '@graph': [person, website, ...jsonLd] }
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b1120" />
    <meta name="author" content={profile.name} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {alternates.map(a => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="google-site-verification" content="oViuJpscTpC3QMYA2uh_ZhdcvwltCa9aR3jBV5YZAVM" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

    <script>
      import { inject } from '@vercel/analytics'
      import { injectSpeedInsights } from '@vercel/speed-insights'

      inject()
      injectSpeedInsights()
    </script>
  </head>
  <body class={bodyClass}>
    <a href="#main" class="sr-only z-50 rounded bg-accent px-4 py-2 text-slate-950 focus:not-sr-only focus:fixed focus:top-3 focus:left-3">
      {lang === 'pl' ? 'Przejdź do treści' : 'Skip to content'}
    </a>
    <slot />
  </body>
</html>
