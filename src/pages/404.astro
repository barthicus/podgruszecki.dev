---
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout lang="en" title="Page not found | Bartosz Podgruszecki" description="This page does not exist." noindex>
  <Header lang="en" />
  <main id="main" class="container-page py-24 sm:py-32">
    <p class="text-sm font-semibold tracking-wider text-accent uppercase">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-ink sm:text-5xl">Page not found<span class="text-accent">.</span></h1>
    <p class="mt-4 max-w-xl text-lg">The page you are looking for doesn't exist or has moved. / Ta strona nie istnieje lub została przeniesiona.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Home</a>
      <a href="/pl" class="btn-ghost">Strona główna (PL)</a>
      <a href="/projects" class="btn-ghost">Projects</a>
    </div>
  </main>
  <Footer lang="en" />
</Layout>
