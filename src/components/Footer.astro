---
import Icon from '@/components/Icon.astro'
import { getProfile } from '@/data/profile'
import { localePath, useTranslations, type Lang } from '@/i18n'

type Props = { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)
const profile = getProfile(lang)
---

<footer class="border-t border-line">
  <div class="container-page flex flex-col gap-2 py-8 text-sm sm:flex-row sm:justify-between">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <p class="flex items-center gap-4">
      <a class="hover:text-ink" href={localePath(lang, '/cv')}>{t.cvHtml}</a>
      <a class="inline-flex items-center gap-1.5 hover:text-ink" href={profile.github} target="_blank" rel="noopener me">
        <Icon name="github" class="size-4" /> GitHub
      </a>
    </p>
  </div>
</footer>
