---
import { Image } from 'astro:assets'

import Icon from '@/components/Icon.astro'
import { projectPeriod, type Project } from '@/data/projects'
import { localePath, useTranslations, type Lang } from '@/i18n'

type Props = { project: Project; lang: Lang; eager?: boolean }
const { project, lang, eager = false } = Astro.props
const t = useTranslations(lang)
---

<article class="group grid gap-6 rounded-2xl border border-line bg-surface/60 p-4 sm:p-6 lg:grid-cols-5 lg:gap-8">
  {
    project.video ? (
      <div class="self-start overflow-hidden rounded-xl border border-line lg:col-span-2">
        <video
          class="aspect-[1256/664] w-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="none"
          poster={project.video.poster}
          aria-label={t.animationOf(project.title)}
          data-autoplay-visible
        >
          <source src={project.video.webm} type="video/webm" />
          <source src={project.video.mp4} type="video/mp4" />
        </video>
      </div>
    ) : (
      project.image && (
        <div class="self-start overflow-hidden rounded-xl border border-line lg:col-span-2">
          <Image
            src={project.image}
            alt={project.gallery?.[0]?.alt ?? t.screenshotOf(project.title)}
            widths={[400, 640, 768, 960]}
            sizes="(min-width: 1024px) 420px, 100vw"
            loading={eager ? 'eager' : 'lazy'}
            class="aspect-[16/10] w-full object-cover object-left-top transition duration-500 group-hover:scale-[1.02]"
          />
        </div>
      )
    )
  }
  <div class:list={['flex flex-col', project.image || project.video ? 'lg:col-span-3' : 'lg:col-span-5']}>
    <p class="text-xs font-semibold tracking-wider text-accent uppercase">
      {project.industry} · {projectPeriod(project)}
    </p>
    <h3 class="mt-2 text-xl font-bold tracking-tight text-ink">
      {
        project.link ? (
          <a href={project.link} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-accent-strong">
            {project.title}
            <Icon name="external" class="size-4 opacity-60" />
            <span class="sr-only">{t.opensInNewTab}</span>
          </a>
        ) : (
          project.title
        )
      }
    </h3>
    {project.impact && <p class="mt-3 text-sm font-medium text-ink">{project.impact}</p>}
    {
      project.anonymised && (
        <p class="mt-2 text-xs text-slate-400/80">{t.anonymisedShort}</p>
      )
    }
    <p class="mt-3 text-[0.95rem]">{project.summary}</p>
    <ul class="mt-auto flex flex-wrap gap-2 pt-5" aria-label={t.technologies}>
      {project.tags.map(tag => <li class="tag">{tag}</li>)}
    </ul>
    {
      project.gallery && (
        <a href={localePath(lang, `/projects#${project.slug}`)} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:text-accent-strong">
          {t.caseStudyLink} <Icon name="arrow" class="size-4" />
        </a>
      )
    }
  </div>
</article>

<script>
  // Play looping videos only while visible (saves data and CPU)
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay-visible]')
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
  const io = new IntersectionObserver(entries => {
    for (const { target, isIntersecting } of entries) {
      const v = target as HTMLVideoElement
      if (isIntersecting && !reduce) v.play().catch(() => {})
      else v.pause()
    }
  })
  videos.forEach(v => {
    v.removeAttribute('autoplay')
    io.observe(v)
  })
</script>
