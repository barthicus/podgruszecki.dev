---
import { formatPeriodFor, getJobs } from '@/data/experience'
import { getProfile, getSkills } from '@/data/profile'
import { localePath, useTranslations, type Lang } from '@/i18n'
import Layout from '@/layouts/Layout.astro'

type Props = { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)
const profile = getProfile(lang)
const skills = getSkills(lang)
const jobs = getJobs(lang)
const formatPeriod = formatPeriodFor(lang)
const pageUrl = new URL(localePath(lang, '/cv'), Astro.site).href
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: profile.name, item: new URL(localePath(lang, '/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'CV', item: pageUrl }
    ]
  },
  {
    '@type': 'ProfilePage',
    url: pageUrl,
    name: t.meta.cvTitle(profile.name, profile.role),
    inLanguage: lang,
    isPartOf: { '@id': `${profile.site}/#website` },
    mainEntity: { '@id': `${profile.site}/#person` }
  }
]

const strip = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '')

// CV bullets support **bold** and [text](url). `case:<slug>` points to a case study on the projects page.
// Links are absolute so they keep working in the PDF.
const projectsUrl = new URL(localePath(lang, '/projects'), Astro.site).href
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
const rich = (text: string) =>
  escape(text)
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[(.+?)\]\((.+?)\)/g, (_, label, href) => `<a href="${href.startsWith('case:') ? `${projectsUrl}#${href.slice(5)}` : href}">${label}</a>`)
---

<Layout
  lang={lang}
  ogType="profile"
  jsonLd={jsonLd}
  title={t.meta.cvTitle(profile.name, profile.role)}
  description={t.meta.cvDescription(profile.name, profile.role, profile.yearsOfExperience)}
  bodyClass="cv-body"
>
  <div class="cv-toolbar">
    <a href={localePath(lang, '/')}>{t.backToWebsite}</a>
    <a href={profile.cvPdf} download class="cv-download">{t.downloadPdf}</a>
  </div>

  <main id="main" class="cv-page">
    <header class="cv-header">
      <div>
        <h1>{profile.name}<span class="dot">.</span></h1>
        <p class="cv-role">{profile.role}</p>
      </div>
      <ul class="cv-contact">
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={profile.site}>{strip(profile.site)}</a></li>
        <li><a href={profile.linkedin}>{strip(profile.linkedin)}</a></li>
        <li><a href={profile.github}>{strip(profile.github)}</a></li>
        <li>{profile.location} · {profile.workMode}</li>
      </ul>
    </header>

    <section>
      <h2>{t.cvSections.summary}</h2>
      <p set:html={t.cvSummary(profile.role, profile.yearsOfExperience)} />
    </section>


    <section>
      <h2>{t.cvSections.experience}</h2>
      {
        jobs.map(job => (
          <article class="cv-job">
            <div class="cv-job-head">
              <h3>
                {job.role} · {job.url ? <a href={job.url} class="company">{job.company}</a> : <span class="company">{job.company}</span>}
                {job.type && <span class="type"> ({job.type})</span>}
              </h3>
              <span class="period">{formatPeriod(job)}</span>
            </div>
            {job.engagements ? (
              <>
                <p class="cv-job-summary">{job.cvSummary ?? job.summary}</p>
                {job.engagements.map(e => (
                  <div class="cv-engagement">
                    <div class="cv-job-head">
                      <h4>
                        {e.url ? <a href={e.url}>{e.company}</a> : e.company}
                        <span class="type"> ({[e.role, e.type].filter(Boolean).join(' · ')})</span>
                      </h4>
                      {(e.end || e.start !== job.start) && <span class="period">{formatPeriod(e)}</span>}
                    </div>
                    <ul>
                      {e.bullets.map(b => (
                        <li set:html={rich(b)} />
                      ))}
                    </ul>
                  </div>
                ))}
              </>
            ) : (
              <ul>
                {job.bullets?.map(b => (
                  <li set:html={rich(b)} />
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </section>

    <section>
      <h2>{t.cvSections.skills}</h2>
      <dl class="cv-skills">
        {
          skills.map(s => (
            <div>
              <dt>{s.group}: </dt>
              <dd>{s.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="cv-cols">
      <section>
        <h2>{t.cvSections.education}</h2>
        {
          profile.education.map(e => (
            <p class="cv-edu">
              <strong>{e.degree}</strong>
              <br />
              {e.school} · <span class="nowrap">{e.years}</span>
            </p>
          ))
        }
      </section>
      <section>
        <h2>{t.cvSections.languages}</h2>
        <p>
          {
            profile.languages.map(l => (
              <>
                <strong>{l.name}</strong>: {l.level}
                <br />
              </>
            ))
          }
        </p>
      </section>
    </div>

    <section>
      <h2>{t.cvSections.interests}</h2>
      <p>{t.cvInterests}</p>
    </section>

    {t.cvConsent && <p class="cv-consent">{t.cvConsent}</p>}
  </main>
</Layout>

<style is:global>
  .cv-body {
    background: #e2e8f0;
    color: #334155;
    font-size: 10pt;
    line-height: 1.45;
  }
  .cv-toolbar {
    max-width: 210mm;
    margin: 0 auto;
    padding: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
  }
  .cv-toolbar a {
    color: #115e59;
    font-weight: 600;
  }
  .cv-toolbar .cv-download {
    background: #0f766e;
    color: white;
    padding: 8px 16px;
    border-radius: 8px;
  }
  .cv-page {
    background: white;
    max-width: 210mm;
    margin: 0 auto 32px;
    padding: 14mm 15mm;
    box-shadow: 0 10px 30px rgb(15 23 42 / 0.15);
  }
  .cv-page a {
    color: #0f766e;
    text-decoration: none;
  }
  .cv-job li a,
  .cv-page h3 a,
  .cv-page h4 a {
    text-decoration: underline;
    text-decoration-color: #5eead4;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .cv-page h3 a,
  .cv-page h4 a {
    color: inherit;
  }
  .cv-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 2px solid #14b8a6;
  }
  .cv-header h1 {
    font-size: 24pt;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #0f172a;
    line-height: 1.1;
  }
  .cv-header .dot {
    color: #14b8a6;
  }
  .cv-role {
    margin-top: 4px;
    font-size: 12pt;
    font-weight: 600;
    color: #0f766e;
  }
  .cv-contact {
    text-align: right;
    font-size: 9pt;
    line-height: 1.5;
  }
  .cv-page section {
    margin-top: 12px;
  }
  .cv-page h2 {
    font-size: 10pt;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0f766e;
    margin-bottom: 5px;
  }
  .cv-page strong {
    color: #0f172a;
    font-weight: 600;
  }
  .cv-job ul {
    list-style: disc;
    padding-left: 14px;
  }
  .cv-job li {
    margin-top: 3px;
  }
  .cv-job li::marker {
    color: #14b8a6;
  }
  .cv-job {
    margin-top: 9px;
    break-inside: avoid;
  }
  .cv-job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .cv-job h3 {
    font-size: 10.5pt;
    font-weight: 600;
    color: #0f172a;
  }
  .cv-job-summary {
    margin-top: 2px;
  }
  .cv-consent {
    margin-top: 16px;
    font-size: 7.5pt;
    line-height: 1.4;
    color: #64748b;
  }
  .cv-engagement {
    margin-top: 7px;
    padding-left: 10px;
    border-left: 2px solid #ccfbf1;
    break-inside: avoid;
  }
  .cv-engagement h4 {
    font-size: 10pt;
    font-weight: 600;
    color: #0f172a;
  }
  .cv-job {
    break-inside: auto;
  }
  .cv-job .company {
    font-weight: 700;
  }
  .cv-job .type,
  .cv-job .period,
  .cv-engagement .type {
    font-weight: 400;
    color: #64748b;
    font-size: 9pt;
    white-space: nowrap;
  }
  .nowrap {
    white-space: nowrap;
  }
  .cv-job-head {
    break-after: avoid;
  }
  .cv-edu + .cv-edu {
    margin-top: 4px;
  }
  .cv-skills div {
    margin-top: 2px;
  }
  .cv-skills dt {
    display: inline;
    font-weight: 600;
    color: #0f172a;
  }
  .cv-skills dd {
    display: inline;
  }
  .cv-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media screen {
    .cv-contact a {
      display: inline-block;
      min-height: 24px;
      padding: 3px 0;
    }
  }
  /* On screen the A4 sheet is scaled up so the text matches the website; the PDF keeps print sizes */
  @media screen and (min-width: 1000px) {
    .cv-toolbar,
    .cv-page {
      zoom: 1.2;
    }
  }
  @media (max-width: 640px) {
    .cv-body {
      font-size: 11pt;
    }
    .cv-page {
      padding: 20px 16px;
    }
    .cv-header,
    .cv-job-head {
      flex-direction: column;
    }
    .cv-contact {
      text-align: left;
    }
    .cv-contact a {
      display: inline-block;
      padding: 6px 0;
    }
    .cv-cols {
      grid-template-columns: 1fr;
    }
  }
  @page {
    size: A4;
    margin: 12mm 14mm;
  }
  @media print {
    .cv-body {
      background: white;
    }
    .cv-toolbar {
      display: none;
    }
    .cv-page {
      box-shadow: none;
      margin: 0;
      padding: 0;
      max-width: none;
    }
    .cv-page h2 {
      break-after: avoid;
    }
  }
</style>
